DATABASE_URL=postgresql+psycopg://nlff:nlff_password@db:5432/nlff

# Comma-separated exact browser origins (scheme and host, without a path).
CORS_ORIGINS=http://localhost:3000
# Temporarily enable safe method/path/origin/status request diagnostics.
LOG_HTTP_REQUESTS=false

ENABLE_TURF_OPTIMIZATION=false

# Persist uploaded files on a Railway volume or other persistent mount.
UPLOAD_STORAGE_DIR=/app/uploads
RULEBOOK_UPLOAD_DIR=/app/uploads/rulebooks
RULEBOOK_MAX_SIZE_BYTES=26214400
HOST_LOCATION_IMAGE_UPLOAD_DIR=/app/uploads/host-locations
HOST_LOCATION_IMAGE_MAX_SIZE_BYTES=10485760
